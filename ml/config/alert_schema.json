{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SENTINEL-AI Alert Schema",
  "description": "Frozen contract for alert JSON objects emitted by the inference pipeline. All downstream components (backend, dashboard, database, report generator) consume this schema.",
  "version": "1.0.0",
  "type": "object",
  "required": ["alert_id", "timestamp", "flow_id", "src_ip", "dst_ip", "src_port", "dst_port", "protocol", "label", "confidence", "action"],
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for this alert"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of alert generation"
    },
    "flow_id": {
      "type": "string",
      "description": "Unique identifier for the network flow"
    },
    "src_ip": {
      "type": "string",
      "format": "ipv4",
      "description": "Source IP address"
    },
    "dst_ip": {
      "type": "string",
      "format": "ipv4",
      "description": "Destination IP address"
    },
    "src_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Source port number"
    },
    "dst_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Destination port number"
    },
    "protocol": {
      "type": "string",
      "enum": ["TCP", "UDP", "OTHER"],
      "description": "Transport protocol"
    },
    "label": {
      "type": "string",
      "enum": ["Benign", "DoS/DDoS", "PortScan", "BruteForce", "WebAttack", "Infiltration"],
      "description": "Predicted classification label"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model prediction confidence (0-1)"
    },
    "explanation": {
      "type": ["object", "null"],
      "description": "SHAP-based explanation for this prediction",
      "properties": {
        "top_features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": { "type": "string" },
              "shap_value": { "type": "number" },
              "direction": { "type": "string", "enum": ["positive", "negative"] },
              "pct_vs_baseline": { "type": "string" }
            }
          }
        },
        "human_readable": {
          "type": "string",
          "description": "Human-readable explanation string"
        }
      }
    },
    "action": {
      "type": "string",
      "enum": ["ALLOW", "ALERT", "MITIGATE"],
      "description": "Decision router action: ALLOW (benign), ALERT (suspicious but below threshold), MITIGATE (auto-block)"
    },
    "mitigation_status": {
      "type": "string",
      "enum": ["n/a", "pending", "applied", "failed", "reversed"],
      "description": "Status of the mitigation action"
    },
    "inference_latency_ms": {
      "type": "number",
      "description": "End-to-end inference latency in milliseconds"
    }
  }
}
