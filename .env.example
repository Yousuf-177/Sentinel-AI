# ============================================
# SENTINEL-AI — Environment Variable Template
# ============================================
# Copy to .env and replace all development credentials before deployment.

PROJECT_NAME=sentinel-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

# ML / inference artifacts (not stored in Git)
# Public Hugging Face model repository.
HF_MODEL_REPO_ID=mohd-yousuf-177/sentinel-ai-models
HF_MODEL_REVISION=2ff9fa8422c0f1df9799fb7874ac3cebe6fb7eae
HF_MODEL_FILENAME=sentinel_cnn_lstm.h5
HF_PREPROCESSOR_FILENAME=preprocessor.pkl
# Optional: cache location. HF_TOKEN is not required for a public model repo.
HF_HUB_CACHE_DIR=.cache/huggingface
# HF_TOKEN=only-needed-for-gated/private downloads; never commit tokens
MODEL_PATH=ml/models/artifacts/sentinel_cnn_lstm.h5
PREPROCESSOR_PATH=ml/models/artifacts/preprocessor.pkl
MODEL_CONFIG_PATH=ml/config/model_config.yaml
CONFIDENCE_THRESHOLD=0.98
FLOW_TIMEOUT_SECONDS=120
CAPTURE_INTERFACE=eth0
CAPTURE_BPF_FILTER=ip

# Python inference -> Node Socket.IO endpoint
SENTINEL_BACKEND_URL=http://127.0.0.1:3001

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# InfluxDB (replace development credentials)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-with-a-secure-token
INFLUXDB_ORG=sentinel-ai
INFLUXDB_BUCKET=network_flows

# Mitigation remains disabled; Phase 4 is detection-only.
MITIGATION_ENABLED=false
WHITELIST_IPS=127.0.0.1,192.168.56.1
AUTO_BLOCK_DURATION_SECONDS=3600
