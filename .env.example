# ============================================
# SENTINEL-AI — Environment Variable Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -------------------- General --------------------
PROJECT_NAME=sentinel-ai
ENVIRONMENT=development    # development | staging | production
LOG_LEVEL=DEBUG            # DEBUG | INFO | WARNING | ERROR

# -------------------- ML / Inference Engine --------------------
MODEL_PATH=ml/models/artifacts/sentinel_cnn_lstm.h5
PREPROCESSOR_PATH=ml/models/artifacts/preprocessor.pkl
FEATURE_SCHEMA_PATH=ml/config/feature_schema.json
CONFIDENCE_THRESHOLD=0.98
FLOW_TIMEOUT_SECONDS=120
CAPTURE_INTERFACE=eth0
SHAP_BACKGROUND_SAMPLES=100

# -------------------- Backend (Node.js) --------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000

# -------------------- Frontend (React) --------------------
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# -------------------- Database (InfluxDB) --------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=sentinel-ai
INFLUXDB_BUCKET=network_flows

# -------------------- Docker --------------------
COMPOSE_PROJECT_NAME=sentinel-ai

# -------------------- Mitigation --------------------
MITIGATION_ENABLED=false
WHITELIST_IPS=127.0.0.1,192.168.56.1
AUTO_BLOCK_DURATION_SECONDS=3600
